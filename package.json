{
  "name": "prayosha-erp-api",
  "version": "0.1.0",
  "private": true,
  "description": "Prayosha ERP backend API (Fastify + MongoDB + S3)",
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/worker.ts",
    "dev:bucket": "tsx --env-file-if-exists=.env scripts/dev/create-local-bucket.ts",
    "smoke:upload": "tsx --env-file-if-exists=.env scripts/dev/smoke-upload.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "node dist/database/scripts/migrate.js",
    "db:migrate:dev": "tsx --env-file-if-exists=.env src/database/scripts/migrate.ts",
    "db:verify-indexes": "node dist/database/scripts/verify-indexes.js",
    "db:verify-indexes:dev": "tsx --env-file-if-exists=.env src/database/scripts/verify-indexes.ts",
    "user:create-owner": "node dist/database/scripts/create-owner.js",
    "user:create-owner:dev": "tsx --env-file-if-exists=.env src/database/scripts/create-owner.ts",
    "openapi:export": "tsx src/docs/export-openapi.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "load:seed": "tsx --env-file-if-exists=.env scripts/load/seed-load-test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1154.0",
    "@aws-sdk/s3-request-presigner": "3.1154.0",
    "@fastify/compress": "9.2.2",
    "@fastify/cookie": "11.1.3",
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/swagger": "9.9.2",
    "@fastify/swagger-ui": "6.1.2",
    "@fastify/under-pressure": "9.2.1",
    "argon2": "0.45.1",
    "bullmq": "6.3.19",
    "fastify": "5.12.7",
    "fastify-plugin": "6.0.1",
    "fastify-type-provider-zod": "7.0.0",
    "ioredis": "6.0.0",
    "jose": "6.2.13",
    "mongodb": "7.7.0",
    "pino": "10.4.0",
    "prom-client": "15.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "aws-sdk-client-mock": "4.1.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "mongodb-memory-server": "11.3.0",
    "openapi-types": "12.1.3",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "argon2": false,
    "esbuild": false,
    "mongodb-memory-server": false,
    "msgpackr-extract": false
  }
}
