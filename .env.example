# -----------------------------------------------------------------------------
# Prayosha API — example environment. PLACEHOLDERS ONLY; never commit real values.
# Local development: cp .env.example .env and replace every "change-me".
# Production: create .env.production on the server (chmod 600), see docs/deployment.md.
# Generate secrets with:  openssl rand -base64 48
# -----------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=info
HOST=0.0.0.0
PORT=3000
# false | hop count (1 behind Caddy) | comma-separated proxy CIDRs
TRUST_PROXY=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5500
# API docs at /docs; defaults to on outside production
# API_DOCS_ENABLED=true

# ---- MongoDB (self-hosted) ----------------------------------------------------
MONGODB_DB_NAME=prayosha
# Application user: custom role prayoshaApp (find/insert/update/remove only).
MONGODB_URI=mongodb://prayosha_app:change-me-app-password@127.0.0.1:27017/prayosha?authSource=prayosha
# Migration user: readWrite + dbAdmin. Used only by `npm run db:migrate`.
MONGODB_MIGRATION_URI=mongodb://prayosha_migrator:change-me-migrator-password@127.0.0.1:27017/prayosha?authSource=prayosha
MONGODB_MAX_POOL_SIZE=20
MONGODB_QUERY_TIMEOUT_MS=5000

# Used by docker compose to initialise users on first start of an empty volume.
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=change-me-root-password
MONGO_APP_PASSWORD=change-me-app-password
MONGO_MIGRATOR_PASSWORD=change-me-migrator-password
MONGO_BACKUP_PASSWORD=change-me-backup-password

# ---- Redis (rate limits, auth-state cache, BullMQ) ----------------------------
REDIS_PASSWORD=change-me-redis-password
REDIS_URL=redis://:change-me-redis-password@127.0.0.1:6379
REDIS_KEY_PREFIX=prayosha:

# ---- Auth -----------------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-to-at-least-32-random-characters-0000
# Set during secret rotation only (old value), then remove.
# JWT_ACCESS_SECRET_PREVIOUS=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600
# Must be true in production (HTTPS). false only for plain-http local dev.
REFRESH_COOKIE_SECURE=false
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_SECONDS=900
RATE_LIMIT_LOGIN_MAX=10

# ---- Object storage -------------------------------------------------------------
S3_BUCKET=prayosha-uploads-dev
S3_REGION=ap-south-1
# Local S3-compatible server (docker compose `s3` service). Leave unset for AWS.
S3_ENDPOINT=http://127.0.0.1:9000
S3_FORCE_PATH_STYLE=true
# Local credentials for the S3 emulator only. In production use an IAM role
# (EC2 instance profile) or a dedicated least-privilege IAM user — see docs.
AWS_ACCESS_KEY_ID=change-me-local-s3-user
AWS_SECRET_ACCESS_KEY=change-me-local-s3-password
UPLOAD_URL_TTL_SECONDS=300
DOWNLOAD_URL_TTL_SECONDS=300

# ---- Operations ------------------------------------------------------------------
# Enables /internal/metrics (Bearer token). Leave unset to disable.
# METRICS_TOKEN=
WORKER_CONCURRENCY=5
